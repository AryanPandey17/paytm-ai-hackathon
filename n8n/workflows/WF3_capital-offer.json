        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ approval_id: $('Webhook').item.json.body.approval_id, decision: $json.data && $json.data.approved ? 'approved' : 'rejected', by: 'ops (whatsapp)' }) }}",
