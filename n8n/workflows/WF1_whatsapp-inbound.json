        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from_number: $('WhatsApp Trigger').item.json.messages[0].from, type: $('WhatsApp Trigger').item.json.messages[0].type, text: $('WhatsApp Trigger').item.json.messages[0].text ? $('WhatsApp Trigger').item.json.messages[0].text.body : null, button_payload: $('WhatsApp Trigger').item.json.messages[0].interactive ? ($('WhatsApp Trigger').item.json.messages[0].interactive.button_reply || $('WhatsApp Trigger').item.json.messages[0].interactive.list_reply || {}).title : ($('WhatsApp Trigger').item.json.messages[0].button ? $('WhatsApp Trigger').item.json.messages[0].button.text : null) }) }}",
        "options": {}
      },
      "id": "c58011d3-df11-443f-8d60-7417150ede7b",
