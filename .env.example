# ─────────────────────────────────────────────────────────────
#  Paytm Commerce OS — environment variables
#  Copy to .env (repo root) and replace the placeholders.
#  Everything is optional: missing keys fall back gracefully
#  (LLM → next provider → offline rules, TTS → browser voice,
#   n8n → simulated actions, Cognee → local graph).
# ─────────────────────────────────────────────────────────────

# ---------- App ----------
APP_ENV=dev
FRONTEND_ORIGIN=http://localhost:5173
# Public URL of the backend (use your ngrok / Cloudflare Tunnel URL so n8n + WhatsApp can fetch audio)
PUBLIC_BACKEND_URL=http://localhost:8000

# ---------- LLM fallback chain ----------
# Tried left → right. A provider is skipped if its key is empty, and put on cooldown
# when its tokens/credits are exhausted (402/429/quota), key rejected, 5xx or timeout.
# "rules" is the final offline fallback so the demo never breaks.
LLM_PROVIDER_ORDER=sarvam,gemini,groq,openrouter,openai,rules
LLM_TIMEOUT_S=25
LLM_COOLDOWN_S=300

# Sarvam (partner) — https://dashboard.sarvam.ai  (₹100 free credits per account)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TRANSLATE_MODEL=mayura:v1

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (has :free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (optional, paid)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ---------- Memory (Cognee, partner) ----------
# local  = built-in SQLite graph (no keys needed)
# cognee = real Cognee memory graph (run: uv sync --extra memory)
MEMORY_BACKEND=local
# Cognee needs its own LLM + embedding provider (defaults to OpenAI). See https://docs.cognee.ai
COGNEE_LLM_API_KEY=your_cognee_llm_api_key_here
# Optional Cognee-native settings (read by the cognee library directly):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS=384

# ---------- n8n (partner) — action + human-approval layer ----------
# Leave empty to SIMULATE all actions locally (demo still runs end-to-end)
N8N_BASE_URL=http://localhost:5678
# Must match the "CommerceOS secret" Header Auth credential in n8n (header name: X-CommerceOS-Secret)
N8N_WEBHOOK_SECRET=change-me
N8N_PATH_UDHAAR=/webhook/udhaar-nudge
N8N_PATH_CAPITAL=/webhook/capital-offer
N8N_PATH_ESCALATION=/webhook/onboarding-escalation
N8N_PATH_SEND=/webhook/whatsapp-send
N8N_PATH_PO=/webhook/bazaar-po

# ---------- WhatsApp Cloud API (configured inside n8n credentials) ----------
# Kept here for reference / docker-compose. https://developers.facebook.com/apps → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Demo phones (must be added as test recipients in Meta; E.164 without '+')
DEMO_MERCHANT_PHONE=919800000001
DEMO_CUSTOMER_PHONE=919800000002
DEMO_OPS_PHONE=919800000003

# ---------- Guardrails ----------
CAPITAL_APPROVAL_THRESHOLD=25000
RESOLVER_CONFIDENCE_THRESHOLD=0.7
NUDGE_COOLDOWN_DAYS=3
